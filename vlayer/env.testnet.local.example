# Copy to  vlayer/.env.testnet.local  (git-ignored). Never commit real secrets.

# --- vlayer ---
# JWT from https://dashboard.vlayer.xyz (the prover/notary API token)
VLAYER_API_TOKEN=

# --- deployer / agent identity key ---
# The SAME identity wallet that mints ERC-8004 + serves ERC-8183 (one agent address).
# Fund it with a little Optimism Sepolia ETH for the Verifier deploy + verify tx.
EXAMPLES_TEST_PRIVATE_KEY=0x

# --- chain ---
OPTIMISM_SEPOLIA_RPC_URL=https://sepolia.optimism.io

# --- data source ---
# The Web Proof attests the FREE, keyless alternative.me Fear & Greed endpoint.
# alternative.me is keyless — NO API key is required to fetch or prove it.

# The agent identity address echoed as a public input (defaults to the deployer if unset).
AGENT_IDENTITY_ADDRESS=
